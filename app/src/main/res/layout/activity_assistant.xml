<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistantRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAFETY ASSISTANT"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your Cyber Safety Guide"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Get simple guidance before you click, call, or pay."
            android:textColor="#AAB7CF"
            android:textSize="15sp" />

        <!-- Welcome Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/traat_card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👋 Hello! I'm your Safety Assistant."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ask about suspicious messages, online payment scams, OTP requests, or suspicious calls."
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="This version provides predefined safety guidance."
                android:textColor="#60A5FA"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Question Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="YOUR QUESTION"
            android:textColor="#93C5FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAssistantQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/traat_card_bg"
            android:gravity="top|start"
            android:hint="e.g. Someone is asking for my OTP..."
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="120dp"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8492AB"
            android:textSize="15sp" />

        <!-- Ask Button -->
        <Button
            android:id="@+id/btnAskAssistant"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/traat_button_bg"
            android:text="Get Safety Guidance"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Answer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/traat_card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAFETY GUIDANCE"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your guidance will appear here."
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Emergency Help -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/traat_card_bg"
            android:padding="16dp"
            android:text="Already lost money to cyber fraud in India? Contact your bank immediately and call 1930 promptly. You can also report the incident at cybercrime.gov.in."
            android:textColor="#FCA5A5"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>